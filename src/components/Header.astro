---
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const { showIntro = false } = Astro.props;
---
<header class="site">
  <div class="wrap header-inner">
    <a href={base} class="logo">
      <img src={`${base}logos/logo-full-clean.png`} alt="Les petits bugs" class="logo-img" width="760" height="238" />
    </a>
    {showIntro && <p class="header-intro">Des idées simples pour débugger le quotidien avec nos enfants, traverser les petits plantages et avancer sans mode d’emploi. Parce qu’en parentalité, même les mises à jour ont leurs bugs.</p>}
    <nav class="main" aria-label="Navigation principale">
      <a href={base}>Accueil</a>
      <a href={`${base}#articles`}>Parentalité</a>
      <a href={`${base}a-propos.html`}>À propos</a>
      <a href={`${base}?recherche=1`} class="nav-search" aria-label="Rechercher">
        <svg width="19" height="19" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.7"/><path d="M13 13l4.25 4.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
      </a>
    </nav>
  </div>
</header>
